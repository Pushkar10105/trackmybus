# API and Socket.io endpoints
# Leave VITE_API_URL empty when using the Vite dev server proxy (recommended)
# or specify the full URL if running on a separate host/port:
VITE_API_URL=
VITE_SOCKET_URL=http://localhost:3000

# Default city coordinates (Hyderabad)
VITE_DEFAULT_LAT=17.4344
VITE_DEFAULT_LNG=78.4659
VITE_DEFAULT_ZOOM=12
