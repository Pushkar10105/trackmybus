# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Note: On Replit, DATABASE_URL is automatically populated when you create a Database.
DATABASE_URL=postgres://postgres:password@localhost:5432/trackmybus

# Secret key used to sign JWT tokens - use a long random string in production
# On Replit, add this under the "Secrets" tool
JWT_SECRET=change_me_to_a_long_random_secret

# Port the Express server will listen on (Replit defaults to 3000)
PORT=3000

# Host binding (defaults to 0.0.0.0 for container/cloud platforms)
HOST=0.0.0.0

# Allowed origin(s) for CORS (comma-separated or '*' for any origin)
CORS_ORIGIN=*

# Gemini API key for POST /api/chat (leave empty to use the static fallback reply)
GEMINI_API_KEY=
